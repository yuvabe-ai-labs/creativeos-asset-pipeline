{
  "manifest_version": 3,
  "name": "CreativeOS Moodboard Clipper",
  "version": "0.3.0",
  "description": "Hover any image — or an Instagram post, YouTube Short, or Pinterest pin — and click + CreativeOS, or right-click, to add it to a client moodboard.",
  "permissions": ["contextMenus", "storage", "sidePanel"],
  "host_permissions": [
    "https://creativeos-yuvabe.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["clip-button.js"],
      "css": ["clip-button.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "CreativeOS Moodboard",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}
