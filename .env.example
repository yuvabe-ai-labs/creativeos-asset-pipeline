# Copy to .env (or .env.local) and fill in real values. Never commit .env.

# OpenAI
OPENAI_API_KEY=

# Kling (Video generation)
KLING_API_KEY=                    # From Kling developer console — shown once, copy immediately

# Google GenAI (Gemini / Veo)
GOOGLE_GENAI_API_KEY=

# App
APP_URL=

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
TRIGGER_WEBHOOK_SECRET=

# Supabase (Postgres + Auth — Storage is now on GCS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Storage (replaces Supabase Storage for new uploads)
GCP_PROJECT_ID=
GCS_BUCKET=
GCP_SERVICE_ACCOUNT_KEY_BASE64=
# Local dev alternative: GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# Google Drive integration (for File node "Pick from Google Drive" feature)
# Register an OAuth 2.0 Web Application client in GCP Console (same project as GCS)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# Refresh token for the team Google account that owns/has access to client Drive folders
GDRIVE_REFRESH_TOKEN=
