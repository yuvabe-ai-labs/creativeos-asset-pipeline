{
  "manifest_version": 3,
  "name": "CreativeOS Moodboard Clipper (Local)",
  "version": "0.3.0",
  "description": "LOCAL DEV build — clips to a CreativeOS dev server on localhost. Do not ship to clients.",
  "permissions": ["contextMenus", "storage", "sidePanel"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["clip-button.js"],
      "css": ["clip-button.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "CreativeOS Moodboard (Local)",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}
